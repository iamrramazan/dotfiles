#!/bin/sh
# screenshot: скриншот в папку и в буфер обмена. Запуск: screenshot full  или  screenshot area

DIR="$HOME/Pictures/Screenshots"                  # папка для скриншотов
mkdir -p "$DIR"                                   # создать папку, если её нет
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"        # имя файла = дата и время, например 2026-10-28_14-05-33.png

case "$1" in                                      # смотрим, какой режим выбрали
  full)                                           # режим: весь экран
    grim "$FILE" ;;                               # grim снимает экран и сохраняет в файл
  area)                                           # режим: выделенная область
    REGION=$(slurp) || exit 0                     # slurp даёт выделить область мышью; если нажали Esc, тихо выходим
    grim -g "$REGION" "$FILE" ;;                  # grim снимает только выбранную область
  *)                                              # любое другое слово: подсказка
    echo "Использование: screenshot full|area" >&2
    exit 1 ;;                                     # выход с ошибкой
esac                                              # конец выбора режима

wl-copy --type image/png < "$FILE"                # положить сохранённую картинку в буфер обмена



# зажечь белую точку на острове (в конце, после успешного снимка и копирования)
qs ipc call island screenshot
